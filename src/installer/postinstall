#!/bin/sh
# Open setup in the active user's session, never as root.
app='/Applications/New Documents.app'
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app" >/dev/null 2>&1 || true
login_user=$(/usr/bin/stat -f '%Su' /dev/console)
case "$login_user" in
    root|loginwindow|'') exit 0 ;;
esac
login_uid=$(/usr/bin/id -u "$login_user")
/bin/launchctl asuser "$login_uid" /usr/bin/sudo -u "$login_user" /usr/bin/open "$app" >/dev/null 2>&1 || true
exit 0
